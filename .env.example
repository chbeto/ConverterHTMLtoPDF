# Copie para .env e ajuste:  cp .env.example .env
# Depois aplique com: docker compose up -d --build

# ---------------------------------------------------------------------------
# Exposição da porta no host
# ---------------------------------------------------------------------------
# 127.0.0.1 -> só a própria VM (padrão, mais seguro; use com Nginx na frente)
# 0.0.0.0   -> aceita conexões de qualquer origem (internet)
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# Vazio = /convert aberto para quem alcançar a porta.
# Ao expor externamente, SEMPRE defina uma chave. Gere uma com:
#   openssl rand -hex 32
API_KEY=

# ---------------------------------------------------------------------------
# CORS (só necessário para chamadas feitas por navegador de outro domínio)
# ---------------------------------------------------------------------------
# Ex.: https://app.exemplo.com  (aceita lista separada por vírgula, ou *)
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Proxy reverso
# ---------------------------------------------------------------------------
# Defina como 1 quando houver Nginx/Traefik na frente, para logar o IP real.
TRUST_PROXY=
